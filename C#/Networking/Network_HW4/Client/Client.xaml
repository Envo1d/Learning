<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Client" Height="450" Width="800" x:Name="Window" Loaded="Window_Loaded" Closing="Window_Closing" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Label Content="Nickname: " Margin="10 10 0 10"></Label>
            <TextBox Margin="10 10" Width="300" x:Name="txtName" TextChanged="txtName_TextChanged"/>
            <Button Content="Connect" x:Name="btnConnect" Click="btnConnect_Click" Margin="0 10"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="msgList"/>
            <ListBox x:Name="usersList" Grid.Column="1" ItemsSource="{Binding Path=Users}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBox Margin="100 10" Width="500" x:Name="txtMsg"/>
            <Button Content="Send" x:Name="btnSend" Click="btnSend_Click" Margin="0 10"/>
        </StackPanel>
    </Grid>
</Window>
