<Window x:Class="Wpf4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf4"
        mc:Ignorable="d"
        Title="Books Store" Height="550" Width="850"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Border CornerRadius="10" Grid.RowSpan="2">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#7be9f6" Offset="0.0"/>
                        <GradientStop Color="#5023da" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel>
                <Border BorderBrush="White" BorderThickness="1" CornerRadius="10">
                    <Grid Height="20" MouseDown="Grid_MouseDown" Background="AliceBlue" Opacity="0.3">
                        <Button Name="Close" Width="20" Height="20" Margin="10,0,10,0" Content="X" HorizontalAlignment="Right" Click="Close_Click"/>
                        <Button Name="Minimize" Width="20" Height="20" Margin="0,0,40,0" Content="_" HorizontalAlignment="Right" Click="Minimize_Click"/>
                    </Grid>
                </Border>
                <Image Source="Images/book.png" Width="90" Margin="3"/>
                <TextBlock Text="Book Store" FontSize="22" FontWeight="Light" FontFamily="helvetica" TextAlignment="Center" Foreground="AliceBlue"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,5,0,0">
                <ListBox x:Name="listbox" Height="360" Margin="10,0,10,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Login" Content="Login" FontSize="20" Margin="100,10,200,0" Width="100" Click="Login_Click"/>
                    <Button x:Name="Buy" Content="Buy" FontSize="20" Margin="270,10,200,0" Width="100" Click="Buy_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
