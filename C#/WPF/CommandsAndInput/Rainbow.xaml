<Window x:Class="Wpf1.Rainbow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf1"
        mc:Ignorable="d"
        Title="Rainbow" Height="434" Width="528">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Button Background="AliceBlue" Click="Button_Click" Name="btn1">
            <Button Background="Aqua" Height="380" Width="488" Name="btn2" Click="btn2_Click">
                <Button Background="Aquamarine" Height="354" Width="458" Name="btn3" Click="btn3_Click">
                    <Button Background="Beige" Height="328" Width="432" Name="btn4" Click="btn4_Click">
                        <Button Background="Black" Height="304" Width="399" Name="btn5" Click="btn5_Click">
                            <Button Background="Red" Height="277" Width="362" Name="btn6" Click="btn6_Click">
                                <Button Background="Green" Height="254" Width="334" Name="btn7" Click="btn7_Click">
                                    <Button Background="Chartreuse" Height="222" Width="292" Name="btn8" Click="btn8_Click">
                                        <Button Background="Yellow" Height="191" Width="256" Name="btn9" Click="btn9_Click">
                                            <Button Background="Lavender" Height="156" Width="223" Name="btn10" Click="btn10_Click">
                                                
                                            </Button>
                                        </Button>
                                    </Button>
                                </Button>
                            </Button>
                        </Button>
                    </Button>
                </Button>
            </Button>
        </Button>
    </Grid>
</Window>
