<Window x:Class="WpfADOAsync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfADOAsync"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical">
    <Grid  Height="50" Margin="0,20,0,0">
        <TextBox x:Name="txtF" Width="700" IsEnabled="False"></TextBox>
    </Grid>
    <Grid Height="50" Margin="0,20,0,0">
        <TextBox x:Name="txtS" Width="700" IsEnabled="False"></TextBox>
    </Grid>
    <Grid Height="50" Margin="0,20,0,0">
        <Button x:Name="Start" HorizontalAlignment="Right" Width="50" Margin="0,0,20,0" FontSize="20" IsEnabled="False" Click="Start_Click">Start</Button>
    </Grid>
    <Grid Margin="0,100,0,0" Height="50">
        <Label FontSize="15" VerticalContentAlignment="Center">Connection string</Label>
        <TextBox x:Name="ConnectionString" Width="500" HorizontalAlignment="Left" Margin="130,0,0,0" TextWrapping="Wrap" TextChanged="ConnectionString_TextChanged"></TextBox>
        <Button x:Name="Connect" Width="50" HorizontalAlignment="Right" Margin="0,0,80,0" Click="Connect_Click">Connect</Button>
        <Button x:Name="Disconnect" Width="70" HorizontalAlignment="Right" Margin="0,0,5,0" Click="Disconnect_Click" IsEnabled="False">Disconnect</Button>
    </Grid>
    </StackPanel>
</Window>
