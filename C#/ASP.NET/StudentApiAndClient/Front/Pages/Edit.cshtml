@page
@model Front.Pages.EditModel
@{
    ViewData["Title"] = "Edit";
}

<div class="container">
    <div class="row">
        <div class="col-lg-8 col-lg-offset-2">
            <form method="post" asp-action="Edit">
                <input hidden id="id" name="id" value="@Model.Student.Id">
                <div class="form-group">
                    <label class="control-label" for="fullname">Full Name</label>
                    <input type="text" class="form-control" id="fullname" name="fullname" value="@Model.Student.FullName" required>
                </div>
                <div class="form-group">
                    <label class="control-label" for="recordbook">Record Book</label>
                    <input type="text" class="form-control" id="recordbook" name="recordbook" value="@Model.Student.RecordBook" required>
                </div>
                <div class="form-group">
                    <label class="control-label" for="phone">Phone</label>
                    <input type="text" class="form-control" id="phone" name="phone" value="@Model.Student.Phone" required>
                </div>
                <div class="form-group">
                    <label class="control-label" for="course">Course</label>
                    <input type="number" min="1" max="6" class="form-control" id="course" name="course" value="@Model.Student.Course" required>
                </div>
                <input type="submit" value="Update" class="btn btn-primary"/>
            </form>
        </div>
    </div>
</div>