<Window x:Class="Wpf4.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf4"
        mc:Ignorable="d"
        Title="Admin" Height="450" Width="800" 
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border CornerRadius="10" Grid.RowSpan="3" Grid.ColumnSpan="2">
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#7be9f6" Offset="0.3"/>
                    <GradientStop Color="#f023da" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border BorderBrush="White" BorderThickness="1" CornerRadius="10" Grid.ColumnSpan="2">
            <Grid Height="20" MouseDown="Grid_MouseDown"  Background="AliceBlue" Opacity="0.3">
                <Button Name="Close" Width="20" Height="20" Margin="10,0,10,0" Content="X" HorizontalAlignment="Right" Click="Close_Click"/>
                <Button Name="Minimize" Width="20" Height="20" Margin="0,0,40,0" Content="_" HorizontalAlignment="Right" Click="Minimize_Click"/>
            </Grid>
        </Border>
        <Image Source="Images/admin.png" Margin="40" Grid.Row="1"/>
        <ListBox x:Name="ListBox" Grid.Column="1" Grid.Row="1" Margin="10" PreviewKeyDown="ListBox_PreviewKeyDown"></ListBox>
        <StackPanel Grid.Column="1" Grid.Row="2">
            <StackPanel Height="150" Margin="10 10 10 0">
                <Label FontFamily="helvetica" FontSize="20" FontWeight="Light" Margin="220,0,0,0">Add Menu</Label>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Title" FontFamily="helvetica" FontSize="20" FontWeight="Light"/>
                    <TextBox x:Name="Title" Width="200" Text="{Binding Path=InBook.Name}" Margin="70 0" FontFamily="helvetica" FontSize="20"/>
                </StackPanel>
                <StackPanel Margin="0 10" Orientation="Horizontal">
                    <TextBlock Text="Price" FontFamily="helvetica" FontSize="20" FontWeight="Light"/>
                    <TextBox x:Name="Price" Width="200" Text="{Binding Path=InBook.Price}" Margin="63 0" FontFamily="helvetica" FontSize="20"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Image Url" FontFamily="helvetica" FontSize="20" FontWeight="Light"/>
                    <TextBox x:Name="Image" Width="200" Margin="24 0" Text="{Binding Path=InBook.ImageUrl}" FontFamily="helvetica" FontSize="20"/>
                </StackPanel>
            </StackPanel>
            <Grid>
                <Button HorizontalAlignment="Right" Width="35" Height="35" Margin="0 0 40 0" Click="Button_Click">
                    Add
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
