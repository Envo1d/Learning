<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="1000" 
        ResizeMode="NoResize" WindowStyle="None"
        Background="#181735"
        >
    <Window.Resources>
        <FontFamily x:Key="dosis">./Fonts/#Dosis</FontFamily>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#0f0f2d" Grid.ColumnSpan="2"
              MouseDown="Grid_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Grid.ColumnSpan="2" Content="Table"
                        Foreground="white"
                        FontSize="12"
                        FontWeight="Medium"
                    x:Name="Tables"
                    Click="Tables_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="{StaticResource dosis}"/>
                        <Setter Property="Background" Value="#fe6584"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ff4c70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="40" Height="15"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="2" Grid.ColumnSpan="2" Content="Graphic"
                        Foreground="white"
                        FontSize="12"
                        FontWeight="Medium"
                    x:Name="Graphics"
                    Click="Graphics_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="{StaticResource dosis}"/>
                        <Setter Property="Background" Value="#fe6584"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ff4c70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="40" Height="15"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Grid.Column="12" Grid.ColumnSpan="2" Content="X"
                        Foreground="white"
                        FontSize="12"
                        FontWeight="Medium"
                    x:Name="Close"
                    Click="Close_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="TextElement.FontFamily" Value="{StaticResource dosis}"/>
                        <Setter Property="Background" Value="#fe6584"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ff4c70"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Width="40" Height="15"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="0 0 0 30">
                <Image Width="50" Height="50" 
                       Source="Images/Logo.png"
                       RenderOptions.BitmapScalingMode="Fant"/>
                <TextBlock Text="Calculator"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource dosis}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Function:"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
                <TextBox x:Name="FunctionBox"
                         Foreground="White"
                         FontSize="14"
                         FontWeight="Light"
                         FontFamily="{StaticResource dosis}"
                         Width="150"
                         Margin="10 0 0 0"
                         BorderThickness="1"
                         TextChanged="FunctionBox_TextChanged">
                    <TextBox.Background>
                        <SolidColorBrush Color="#fff" Opacity="0.2"/>
                    </TextBox.Background>
                </TextBox>
            </StackPanel>
            <TextBlock Text="Borders:"
                       Foreground="white"
                       FontSize="16"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Start:"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
                <TextBox x:Name="StartbBox"
                         Foreground="White"
                         FontSize="14"
                         FontWeight="Light"
                         FontFamily="{StaticResource dosis}"
                         Width="100"
                         Margin="11 0 0 0"
                         BorderThickness="1">
                    <TextBox.Background>
                        <SolidColorBrush Color="#fff" Opacity="0.2"/>
                    </TextBox.Background>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="End:"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
                <TextBox x:Name="EndbBox"
                         Foreground="White"
                         FontSize="14"
                         FontWeight="Light"
                         FontFamily="{StaticResource dosis}"
                         Width="100"
                         Margin="17 0 0 0"
                         BorderThickness="1">
                    <TextBox.Background>
                        <SolidColorBrush Color="#fff" Opacity="0.2"/>
                    </TextBox.Background>
                </TextBox>
            </StackPanel>
            <TextBlock Text="Another params:"
                       FontSize="16"
                       FontWeight="Medium"
                       Foreground="White"
                       FontFamily="{StaticResource dosis}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Step:"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
                <TextBox x:Name="StepBox"
                         Foreground="White"
                         FontSize="14"
                         FontWeight="Light"
                         FontFamily="{StaticResource dosis}"
                         Width="100"
                         Margin="13 0 0 0"
                         BorderThickness="1">
                    <TextBox.Background>
                        <SolidColorBrush Color="#fff" Opacity="0.2"/>
                    </TextBox.Background>
                </TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="y(x) ="
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
                <TextBox x:Name="StartYBox"
                         Foreground="White"
                         FontSize="14"
                         FontWeight="Light"
                         FontFamily="{StaticResource dosis}"
                         Width="100"
                         Margin="11 0 0 0"
                         BorderThickness="1">
                    <TextBox.Background>
                        <SolidColorBrush Color="#fff" Opacity="0.2"/>
                    </TextBox.Background>
                </TextBox>
            </StackPanel>
            <TextBlock Text="Method:"
                       Foreground="white"
                       FontSize="16"
                       FontWeight="Medium"
                       FontFamily="{StaticResource dosis}"/>
            <ComboBox x:Name="MethodCombo" SelectedIndex="0"
                      FontFamily="{StaticResource dosis}" FontSize="16">
                <ComboBoxItem Content="Eiler"/>
                <ComboBoxItem Content="Runge"/>
            </ComboBox>
            <StackPanel Margin="0 30 0 0" Orientation="Horizontal">
                <Button x:Name="C" Content="C"
                        Foreground="white"
                        FontSize="14"
                        FontWeight="Medium"
                        Click="C_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="{StaticResource dosis}"/>
                            <Setter Property="Background" Value="#fe6584"/>
                            <Setter Property="Cursor" Value="Hand"/>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ff4c70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="100" Height="25"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="Calc" Content="Calculate"
                        Foreground="white"
                        FontSize="14"
                        FontWeight="Medium"
                        Click="Calc_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="TextElement.FontFamily" Value="{StaticResource dosis}"/>
                            <Setter Property="Background" Value="#fe6584"/>
                            <Setter Property="Cursor" Value="Hand"/>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ff4c70"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="100" Height="25"
                                    CornerRadius="12"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Grid.RowSpan="2"
              Margin="160 -365 -610 85"
              Panel.ZIndex="-1">
            <Grid.RenderTransform>
                <RotateTransform Angle="50"/>
            </Grid.RenderTransform>

            <StackPanel Orientation="Horizontal"
                        Margin="-350 250 -255 -250">
                <StackPanel>
                    <Border Width="700"
                            Height="35"
                            Background="#3dddc2"
                            Margin="150 0 0 0"
                            CornerRadius="20"
                            Opacity="0.5"/>
                    <Border Width="700"
                            Height="35"
                            Background="#fc6586"
                            Margin="0 15 0 0"
                            CornerRadius="20"
                            Opacity="0.5"/>
                    <Border Width="700"
                            Height="35"
                            Background="#383660"
                            Margin="75 15 0 0"
                            CornerRadius="20"
                            />
                </StackPanel>
                <StackPanel>
                    <Border Width="700"
                            Height="35"
                            Background="#3dddc2"
                            Margin="150 0 0 0"
                            CornerRadius="20"
                            Opacity="0.5"/>
                    <Border Width="700"
                            Height="35"
                            Background="#fc6586"
                            Margin="0 15 0 0"
                            CornerRadius="20"
                            Opacity="0.5"/>
                    <Border Width="700"
                            Height="35"
                            Background="#383660"
                            Margin="75 15 0 0"
                            CornerRadius="20"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <FlowDocumentScrollViewer Grid.Row="1" Grid.Column="1" x:Name="docL">
            <FlowDocument Name="doc">
                <Paragraph FontSize="14pt" Foreground="white"
                           FontFamily="{StaticResource dosis}">Result</Paragraph>
            </FlowDocument>
        </FlowDocumentScrollViewer>
        <Grid Grid.Row="1" Grid.Column="1" x:Name="Graphic" Visibility="Collapsed">
            <lvc:CartesianChart Series="{Binding SeriesCollection}">
                <lvc:CartesianChart.Resources>
                    <Style TargetType="lvc:Separator">
                        <Setter Property="Stroke" Value="LightGray"></Setter>
                    </Style>
                </lvc:CartesianChart.Resources>
                <lvc:CartesianChart.AxisX>
                    <lvc:LogarithmicAxis LabelFormatter="{Binding Formatter}" 
                                     Base="{Binding Base}" >
                        <lvc:LogarithmicAxis.Separator>
                            <lvc:Separator StrokeThickness="1" IsEnabled="True"></lvc:Separator>
                        </lvc:LogarithmicAxis.Separator>
                    </lvc:LogarithmicAxis>
                </lvc:CartesianChart.AxisX>
            </lvc:CartesianChart>
        </Grid>
    </Grid>
</Window>
