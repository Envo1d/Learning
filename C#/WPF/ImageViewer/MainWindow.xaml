<Window x:Class="Practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Image Gallery 1.0" Height="450" Width="800" MinHeight="450" MinWidth="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Image Margin="5" Grid.RowSpan="2" Grid.Column="0" Name="Images"></Image>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="First" Margin="5,10,0,10" Click="First_Click">First</Button>
            <Button x:Name="Previous" Margin="5,10,0,10" Grid.Column="1" Click="Previous_Click">Previous</Button>
            <Button x:Name="Next" Margin="5,10,0,10" Grid.Column="2" Click="Next_Click">Next</Button>
            <Button x:Name="Last" Margin="5,10,0,10" Grid.Column="3" Click="Last_Click">Last</Button>
        </Grid>
        <Slider x:Name="SliderNum" ValueChanged="Slider_ValueChanged"  Grid.RowSpan="2" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="5" Minimum="0" TickFrequency="1" TickPlacement="Both"></Slider>
        <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Vertical">
            <Border BorderBrush="Blue" BorderThickness="3" Margin="5" CornerRadius="10" Padding="5">
                <StackPanel Orientation="Vertical">
                    <Label Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Image information</Label>
                    <TextBlock x:Name="Info" Height="100" TextAlignment="Center"></TextBlock>
                </StackPanel>
            </Border>
            <Border BorderBrush="Blue" BorderThickness="3" Margin="5" CornerRadius="10" Padding="5">
                <StackPanel Margin="6">
                    <Label Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Image mark</Label>
                    <RadioButton Name="Five" HorizontalAlignment="Left" Margin="55,0,0,0" Click="RadioClicked">5 (Perfect)</RadioButton>
                    <RadioButton Name="Four" HorizontalAlignment="Left" Margin="55,0,0,0" Click="RadioClicked">4 (Good)</RadioButton>
                    <RadioButton Name="Three" HorizontalAlignment="Left" Margin="55,0,0,0" Click="RadioClicked">3 (Normal)</RadioButton>
                    <RadioButton Name="Two"  HorizontalAlignment="Left" Margin="55,0,0,0" Click="RadioClicked">2 (Bad)</RadioButton>
                    <RadioButton Name="One" HorizontalAlignment="Left" Margin="55,0,0,0" Click="RadioClicked">1 (Awful)</RadioButton>
                </StackPanel>
            </Border>
        </StackPanel>
        <Button x:Name="btnPath" Grid.Column="2" Grid.Row="2" Margin="90,10,90,10" Click="btnPath_Click">
            Path
        </Button>
    </Grid>
</Window>
