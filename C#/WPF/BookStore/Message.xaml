<Window x:Class="Wpf4.Message"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf4"
        mc:Ignorable="d"
        Title="Message" Height="200" Width="250"  
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize">
    <Grid MouseDown="Grid_MouseDown">
        <Border CornerRadius="10" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#7be9f6" Offset="0.0"/>
                    <GradientStop Color="#5023da" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel>
            <TextBlock Margin="0,20,0,0" FontSize="20" FontWeight="Light" FontFamily="helvetica" TextAlignment="Center" Foreground="AliceBlue">Thak you</TextBlock>
            <TextBlock Margin="0,20,0,0" FontSize="20" FontWeight="Light" FontFamily="helvetica" TextAlignment="Center" Foreground="AliceBlue">For your purchase</TextBlock>
            <Button Margin="50,50,50,0" FontSize="15" Click="Button_Click">Ok</Button>
        </StackPanel>
    </Grid>
</Window>
