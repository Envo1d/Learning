<Window x:Class="Wpf1.OnlyUpReg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf1"
        mc:Ignorable="d"
        Title="OnlyUpReg" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="1" TextWrapping="Wrap" x:Name="box" PreviewKeyDown="box_PreviewKeyDown"></TextBox>
        <TextBlock x:Name="txtBlock" Text="{Binding ElementName=box, Path=Text}" TextWrapping="Wrap"></TextBlock>
    </Grid>
</Window>
