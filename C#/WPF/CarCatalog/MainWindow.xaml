<Window x:Class="Practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Cars for everyone" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="462*"/>
            <ColumnDefinition Width="330*"/>
        </Grid.ColumnDefinitions>
        <ListView Name="Cars" Grid.Row="1" SelectionChanged="Cars_SelectionChanged" PreviewKeyDown="Cars_PreviewKeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Model}" Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Click="GridViewColumnHeader_Click">Model</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Color}" Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Click="GridViewColumnHeader_Click_1">Color</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Type}" Width="60">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Click="GridViewColumnHeader_Click_2">Type</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Price}">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Click="GridViewColumnHeader_Click_3">Price</GridViewColumnHeader>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Header="Image" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Image Source="{Binding ImageUrl}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate> 
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Column="1" Grid.Row="1" DataContext="{Binding ElementName=Cars, Path=SelectedItem}">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Model" FontSize="15" Margin="5,22,0,10" Height="30" Width="50" HorizontalAlignment="Left"/>
            <TextBox x:Name="ModelTxt" FontSize="15" Text="{Binding Path=Model}" Margin="112,22,29,10" Height="30"/>
            <TextBlock Text="Color" FontSize="15" Margin="5,20,0,12" Height="30" Width="68" HorizontalAlignment="Left" Grid.Row="1"/>
            <TextBox x:Name="ColorTxt" FontSize="15" Text="{Binding Path=Color}" Margin="112,20,29,12" Height="30" Grid.Row="1"/>
            <TextBlock Text="Type" FontSize="15" Margin="5,22,0,10" Height="30" Width="51" HorizontalAlignment="Left" Grid.Row="2"/>
            <ComboBox x:Name="TypesCmb" Grid.Row="2" Margin="112,20,29,12" Height="30" FontSize="15" Text="{Binding Path=Type}">
                <TextBlock>Sedan</TextBlock>
                <TextBlock>Coupe</TextBlock>
                <TextBlock>Sport</TextBlock>
                <TextBlock>StationWagon</TextBlock>
                <TextBlock>Hatchback</TextBlock>
                <TextBlock>Minivan</TextBlock>
            </ComboBox>
            <TextBlock Text="Price" FontSize="15" Margin="5,20.5,0,11.5" Height="30" Width="73" HorizontalAlignment="Left" Grid.Row="3"/>
            <TextBox x:Name="PriceTxt" FontSize="20" Text="{Binding Path=Price}" Margin="112,20,29,11.5" Height="30" Grid.Row="3"/>
            <TextBlock Text="ImageUrl" FontSize="15" Margin="5,20.5,0,11.5" Height="30" Width="73" HorizontalAlignment="Left" Grid.Row="4"/>
            <TextBox x:Name="ImageTxt" FontSize="20" Text="{Binding Path=ImageUrl}" Margin="112,20.5,29,11" Height="30" Grid.Row="4"/>
            <Button x:Name="Add" Grid.Row="5" Margin="20" Click="Button_Click">Add</Button>
        </Grid>
        <TextBlock Grid.Column="1" Text="Filter by" Margin="5,10" FontSize="20"/>
        <ComboBox Grid.Column="1" Margin="90, 10,10,10" Name="CmbFilter" SelectionChanged="CmbFilter_SelectionChanged" FontSize="15">
            <TextBlock>Model</TextBlock>
            <TextBlock>Color</TextBlock>
            <TextBlock>Price</TextBlock>
            <TextBlock>Type</TextBlock>
        </ComboBox>
        <TextBlock Text="Filter:" Margin="20,10,10,10" FontSize="20"/>
        <TextBox x:Name="filterTxt" Margin="120, 10, 20, 10" TextChanged="filterTxt_TextChanged"/>
    </Grid>
</Window>
