<Window x:Class="Practice.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice"
        mc:Ignorable="d"
        Title="Image Gallery 1.0 - Registration" Height="658.648" Width="350" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid>
        <Border BorderBrush="Blue" BorderThickness="2" Margin="10" CornerRadius="10" Padding="10">
            <StackPanel>
                <Label FontSize="15" Width="185">
                    Image Gallery Registration
                </Label>
                <StackPanel Margin="0,30,0,0">
                    <Label Name="lLogin" FontSize="15" HorizontalAlignment="Left">Login</Label>
                    <TextBox Name="Login" HorizontalAlignment="Left" Width="300" TextChanged="Login_TextChanged" FontSize="18"></TextBox>
                </StackPanel>
                <StackPanel Margin="0,30,0,0">
                    <Label Name="lPassword" FontSize="15" HorizontalAlignment="Left">Password</Label>
                    <TextBox Name="Password" FontSize="18" HorizontalAlignment="Left" TextChanged="Password_TextChanged" Width="300"></TextBox>
                </StackPanel>
                <StackPanel Margin="0,30,0,0">
                    <Label Name="lPassAgain" FontSize="15" HorizontalAlignment="Left">Password again</Label>
                    <TextBox Name="PasswordAgain" FontSize="18" HorizontalAlignment="Left" TextChanged="PasswordAgain_TextChanged" Width="295"></TextBox>
                </StackPanel>
                <Label Margin="0,40,0,0" HorizontalAlignment="Left">About yourself</Label>
                <StackPanel Margin="0,10,0,0">
                    <Label Name="lName" FontSize="15" HorizontalAlignment="Left">Name</Label>
                    <TextBox x:Name="Name" FontSize="18" HorizontalAlignment="Left" Width="300" TextChanged="Name_TextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,30,0,0">
                    <Label Name="lSurname"  FontSize="15" HorizontalAlignment="Left">Surname</Label>
                    <TextBox Name="Surname" FontSize="18" HorizontalAlignment="Left" Width="300" TextChanged="Surname_TextChanged"></TextBox>
                </StackPanel>
                <StackPanel Margin="0,30,0,0" Height="40" Orientation="Horizontal">
                    <Button Name="Ok" Width="135" Margin="10,5,0,5" Click="Ok_Click">Ok</Button>
                    <Button Name="Cancel" Width="135" Margin="10,5,0,5" Click="Cancel_Click">Cancel</Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
