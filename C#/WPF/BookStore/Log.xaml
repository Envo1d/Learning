<Window x:Class="Wpf4.Log"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf4"
        mc:Ignorable="d"
        Title="Log" Height="300" Width="500"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize">
    <Grid MouseDown="Grid_MouseDown">
        <Border CornerRadius="10" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush>
                    <GradientStop Color="#eba9f6" Offset="0.0"/>
                    <GradientStop Color="#e0232a" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <StackPanel>
            <Image Source="Images/login.png" Width="70" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                <TextBlock Text="Login" FontFamily="helvetica" FontSize="20" FontWeight="Light" Margin="10,0,0,0"/>
                <TextBox x:Name="LoginTxt" Width="200" Margin="101 0" FontFamily="helvetica" FontSize="20"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <TextBlock Text="Password" FontFamily="helvetica" FontSize="20" FontWeight="Light" Margin="10,0,0,0"/>
                <TextBox x:Name="Password" Width="200" Margin="70 0" FontFamily="helvetica" FontSize="20"/>
            </StackPanel>
            <Button x:Name="LoginBtn" Content="Login" Margin="100,40,100,0" FontSize="20" Click="LoginBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
